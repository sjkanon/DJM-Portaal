# De inhoud van logs/ en opslag/ hoort niet in git, maar de .htaccess die de
# map afschermt juist wél: zonder die uitzondering staat hij na een verse
# checkout niet op de server.
logs/*
!logs/.gitkeep
!logs/.htaccess
opslag/*
!opslag/.gitkeep
!opslag/.htaccess
# .env zelf, plus de reservekopieën die setup.php maakt voordat het bestand
# wordt overschreven, en het tijdelijke bestand waarmee dat gebeurt.
.env
.env.backup-*
.env.tmp-*
config.local.php
.DS_Store

# Het via Beheer > Instellingen geüploade logo hoort bij één installatie, niet
# bij de code. De rest van assets/ (djm.css en assets/vendor/) hoort er wél in:
# zonder die bestanden heeft een verse checkout geen opmaak.
assets/logo.png
assets/logo.jpg
assets/logo.webp
assets/logo.svg

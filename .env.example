# ─── DJM Portaal — omgevingsconfiguratie ─────────────────────────────────────
# Kopieer dit bestand naar .env en vul de waarden in. .env staat NIET in git.

# Applicatie
APP_NAME="Deventer Jeugd Musical"
APP_URL=https://portaal.example.nl
DEBUG=false

# Database
DB_HOST=localhost
DB_NAME=djm_portaal
DB_USER=djm_portaal
DB_PASS=
DB_CHARSET=utf8mb4

# Beveiliging — genereer met: php -r "echo bin2hex(random_bytes(32));"
# OTP_PEPPER wordt gebruikt om inlogcodes te hashen. Wijzigen maakt openstaande
# codes ongeldig. APP_KEY ondertekent downloadlinks en remember-tokens.
OTP_PEPPER=
APP_KEY=

# Opslag van de videobestanden. Bij voorkeur BUITEN de webroot,
# bijvoorbeeld /var/djm-opslag. Standaard de map opslag/ in dit project.
OPSLAG_PAD=

# Uitlevering van downloads:
#   auto      = zelf detecteren (nginx -> xaccel, Apache+mod_xsendfile -> xsendfile, anders php)
#   xaccel    = nginx X-Accel-Redirect  (vereist XACCEL_PREFIX + internal location)
#   xsendfile = Apache/Lighttpd X-Sendfile (vereist mod_xsendfile)
#   php       = uitleveren door PHP zelf, met ondersteuning voor hervatten
DELIVERY_MODE=auto
XACCEL_PREFIX=/beveiligd/

# Microsoft Graph (app-only). Kan ook via Beheer > Instellingen worden ingesteld;
# waarden hier hebben voorrang bij een verse installatie.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_VAN_ADRES=
MAIL_VAN_NAAM="Deventer Jeugd Musical"

# SMTP-fallback (optioneel, alleen gebruikt als e-mailmethode op 'smtp' staat)
SMTP_HOST=
SMTP_POORT=587
SMTP_BEVEILIGING=tls
SMTP_GEBRUIKER=
SMTP_WACHTWOORD=

# De testscripts horen alleen op de commandoregel te draaien. Ze wijzigen en
# wissen gegevens (smoke.php leegt de deelnemers- en jaargangentabel), dus ze
# mogen nooit via de browser te starten zijn.
#
# Elk script weigert zelf al een webverzoek, maar deze map hoort helemaal niet
# op een productieserver te staan: upload hem niet mee. Dit bestand is het
# vangnet voor als dat tóch gebeurt.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
